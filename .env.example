# ============================================================
# AAA Ski Platform — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================

# --- Database (Postgres) ---
# Default: the bundled container.  npm run db:up   (host port 5434)
# The image already ships btree_gist, which the no-double-booking exclusion
# constraint needs; the migration enables it.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/ski?schema=public"

# Alternative: a native PostgreSQL 17 service on the default port, if you would
# rather not run Docker. Create the database and extension once:
#   createdb -U postgres ski
#   psql -U postgres -d ski -c "CREATE EXTENSION IF NOT EXISTS btree_gist;"
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ski?schema=public"

# --- Auth.js / NextAuth v5 ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-plus-char-random-string"
AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Scope stays minimal (openid email profile). We deliberately do NOT request
# calendar scopes — coaches subscribe to the ICS feed instead.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Coach / admin allowlists (comma-separated emails, lowercase) ---
# On first Google sign-in a matching email is promoted to COACH / ADMIN and a
# CoachProfile is created automatically.
COACH_EMAILS="kevin@example.com,alisa@example.com"
ADMIN_EMAILS=""

# --- Private file storage ---
# Payment screenshots and signed waiver PDFs live here. This directory MUST be
# outside public/ — anything under public/ is served unauthenticated.
STORAGE_DIR="./storage"

# --- Transactional email (booking confirmations + waiver signing links) ---
# Transactional only. No marketing list (CASL).
# Leave SMTP_HOST empty in dev: mail is then logged to the console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AAA Ski <no-reply@example.com>"

# --- Cron endpoint auth (hold sweeping + retention) ---
CRON_SECRET="replace-me-with-a-random-string"

# --- Public base URL (used to build signing links and the ICS feed URL) ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Development sign-in bypass (optional) ---
# Set to 1 to browse the site without Google OAuth credentials. Everyone
# becomes a demo account and a red banner says so.
#   npm run dev:demo   # seeds the demo coach/student this uses
# Ignored when NODE_ENV=production, and the server refuses to boot if it is set
# there — it would otherwise expose every booking, waiver and screenshot.
DEV_AUTH_BYPASS=
