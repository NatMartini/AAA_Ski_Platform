// AAA Ski Platform — data model
//
// Design notes that are easy to get wrong later:
//
//  * All DateTimes are stored in UTC. Every business decision (which hour grid
//    a day has, which ski season a lesson falls in, whether a participant is a
//    minor) is made in America/Toronto via src/lib/time.ts. The season spans a
//    DST boundary in March, so never construct dates from bare strings.
//
//  * Money is integer cents. No floats anywhere.
//
//  * A Waiver hangs off a Participant, never off a User account. One parent
//    account can have several participants (themselves + each child), and each
//    needs their own waiver. See src/lib/waiver/validity.ts.
//
//  * Waiver rows are append-only. There is no update path: a correction means
//    signing a new one and setting revokedAt on the old. This is what makes the
//    signed PDF defensible as an electronic record.
//
//  * Uploaded files are referenced by a storage *key* (relative path), never a
//    URL. They live outside public/ and are streamed by authenticated routes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Auth ───────────────────────────

enum UserRole {
  CUSTOMER
  COACH
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  phone         String?
  wechatId      String?

  // Kill switches. Checked against fresh DB state on every protected request,
  // because a JWT keeps asserting the old values until it expires.
  disabledAt         DateTime?
  tokenInvalidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  coachProfile CoachProfile?
  participants Participant[]
  bookings     Booking[]     @relation("BookingAccount")
  coachDays    CoachDay[]
  coachBooking Booking[]     @relation("BookingCoach")
  reviewed     Booking[]     @relation("BookingReviewer")
  cancelled    Booking[]     @relation("BookingCanceller")
  waivers      Waiver[]      @relation("WaiverSigner")
  coachWaivers Waiver[]      @relation("WaiverCoach")

  packages           LessonPackage[]     @relation("PackageAccount")
  packagesPaidTo     LessonPackage[]     @relation("PackagePayee")
  packagesReviewed   LessonPackage[]     @relation("PackageReviewer")
  packageAdjustments PackageAdjustment[] @relation("PackageAdjuster")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────── Resorts & coaches ───────────────────────

model Resort {
  id       String  @id @default(cuid())
  slug     String  @unique // "msl" | "blue-mountain"
  nameEn   String
  nameZh   String
  timezone String  @default("America/Toronto")
  address  String?
  isActive Boolean @default(true)
  order    Int     @default(0)

  coachDays CoachDay[]
  bookings  Booking[]
  packages  LessonPackage[]
}

model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique

  displayName String
  bioEn       String? @db.Text
  bioZh       String? @db.Text
  /// Storage key for a photo the coach uploaded. `avatarUrl` holds the
  /// route that serves it, so every consumer just renders a URL.
  avatarKey   String?
  avatarUrl   String?

  // Pricing. Hourly rates live in CoachRate, one per lesson type. The
  // handover credit is not a setting: it is always the ten minutes' fee at
  // the booked rate (lib/pricing.ts).
  minHours      Int @default(2)
  maxHours      Int @default(8)
  leadTimeHours Int @default(24)

  // Group lessons: each additional student adds this much per hour on top of
  // the base rate. $20 default → 1-on-2 is base+20/h, 1-on-3 base+40/h.
  extraPersonCents Int @default(2000)
  // Largest group a single booking may be for. 1 disables group bookings.
  maxGroupSize     Int @default(3)

  // ── Qualifications and what this coach teaches ──
  /// CSIA certification level, 1-4. Shown to students when they pick a coach.
  csiaLevel       Int?
  /// CSIA Park certification level, 1-2. Null when not park-certified.
  csiaParkLevel   Int?
  /// Skill keys from lib/skills.ts this coach teaches (e.g. "wedge",
  /// "parallel", "carving"). String keys rather than a DB enum so the
  /// catalogue can grow without a migration.
  teachableSkills String[] @default([])
  /// Student levels this coach accepts, for auto-assignment.
  teachableLevels String[] @default([])

  // Payment. Money goes directly to each coach — the platform never pools it.
  emtEnabled       Boolean @default(true)
  emtEmail         String?
  emtName          String?
  wechatPayEnabled Boolean @default(false)
  wechatPayQrKey   String?
  alipayEnabled    Boolean @default(false)
  alipayQrKey      String?

  wechatId     String?
  contactEmail String?
  contactPhone String?

  // Shown on the review page before a booking is created, and snapshotted onto
  // the booking. Must be non-empty before the coach can accept bookings.
  cancellationPolicyEn String? @db.Text
  cancellationPolicyZh String? @db.Text

  // Secret token for the read-only ICS subscription feed.
  icsToken String @unique

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rates CoachRate[]
}

/// What a coach charges per hour, one-on-one, for one kind of lesson.
///
/// No row means the coach does not offer that lesson type. Early bird applies
/// to bookings made on or before 1 December (see lib/rates.ts); a null
/// earlyBirdCents means that type has no early-bird price.
model CoachRate {
  id        String @id @default(cuid())
  profileId String

  /// Key from lib/lesson-types.ts, e.g. "riding", "csia1_prep", "park".
  lessonType     String
  regularCents   Int
  earlyBirdCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, lessonType])
}

/// One coach, one resort, one day, one availability window.
/// `date` is the Toronto calendar date; hours are Toronto wall-clock hours.
model CoachDay {
  id       String   @id @default(cuid())
  coachId  String
  resortId String
  date     DateTime @db.Date

  startHour Int // e.g. 9
  endHour   Int // e.g. 16 (exclusive)

  // Lunch defaults to 13:00-14:00 and is auto-blocked. Null disables it.
  breakStartHour Int? @default(13)
  breakEndHour   Int? @default(14)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach    User      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  resort   Resort    @relation(fields: [resortId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@unique([coachId, date]) // a coach is at one resort per day
  @@index([date])
}

// ───────────────────────── Participants ─────────────────────────

enum SkillLevel {
  FIRST_TIME
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// The person actually taking the lesson. Waivers hang off this, not off User,
/// so a parent booking for two children keeps three separate waiver records.
model Participant {
  id        String @id @default(cuid())
  accountId String

  fullName String

  /// Whether this participant is under 18.
  ///
  /// Deliberately a flag rather than a date of birth: the only thing the system
  /// needs is "does a guardian have to sign", and a date of birth is more
  /// personal data than that question requires. The cost is that we cannot
  /// detect the day someone turns 18 on our own — instead, flipping this to
  /// false invalidates a guardian-signed waiver and forces the now-adult
  /// participant to sign for themselves. See lib/waiver/validity.ts.
  isMinor Boolean @default(false)

  /// normalize(fullName). Stops one account creating the same person twice and
  /// thereby side-stepping an existing signed waiver.
  identityKey String

  /// true when this participant is the account holder. Adults who are not the
  /// account holder cannot be created through self-serve booking: nobody can
  /// sign a waiver on behalf of another adult.
  isSelf Boolean @default(false)

  email      String?
  phone      String?
  wechatId   String?
  skillLevel SkillLevel?

  /// Self-reported ability, used to auto-assign a coach. Keys from
  /// lib/skills.ts, not a DB enum, so the catalogue can grow without migrating.
  level String?

  emergencyContactName  String?
  emergencyContactPhone String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account  User      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookings Booking[]
  waivers  Waiver[]

  @@unique([accountId, identityKey])
  @@index([accountId])
}

// ─────────────────────────── Bookings ───────────────────────────

enum BookingStatus {
  /// Self-serve booking; slot is held until holdExpiresAt then auto-released.
  HOLD
  /// Coach created this for a student; waiting on the signing link. No timeout.
  AWAITING_WAIVER
  /// Waiver done, waiting on payment + proof.
  AWAITING_PAYMENT
  /// Proof uploaded, waiting on the coach.
  PENDING_PAYMENT_REVIEW
  /// Coach rejected the proof. Slot is kept; customer may re-upload.
  PAYMENT_REJECTED
  CONFIRMED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  EMT
  WECHAT
  ALIPAY
}

/// How the student chose to pay.
enum PaymentPlan {
  /// Everything up front.
  FULL
  /// One hour now to hold the slot, the balance settled after the lesson.
  DEPOSIT
  /// Paid for from a prepaid lesson package; nothing is due on the booking.
  PACKAGE
}

enum UploadedBy {
  CUSTOMER
  COACH
}

model Booking {
  id   String @id @default(cuid())
  code String @unique // short human-facing reference, e.g. SKI-8F3K2M

  // Null until a coach-created booking's signing link is used.
  accountId     String?
  participantId String?

  coachId    String
  resortId   String
  coachDayId String

  createdByCoach Boolean @default(false)

  // Booked block, on the hour, UTC.
  startAt DateTime
  endAt   DateTime
  hours   Int

  // How many students this lesson is for. Drives the per-hour rate.
  headcount Int @default(1)

  /// Key from lib/lesson-types.ts. Chooses which of the coach's rates applied.
  lessonType String  @default("riding")
  /// Booked on or before 1 December, so the early-bird rate was charged.
  earlyBird  Boolean @default(false)

  // Actual teaching window: startAt + 10min, endAt. The 10 minutes are the
  // handover from the previous student; their fee is handoverDiscountCents.
  lessonStartAt DateTime
  lessonEndAt   DateTime

  // Price snapshot taken at booking time so later rate changes never rewrite
  // an existing booking. hourlyRateCents is the BASE (one-student) rate for
  // the lesson type — or, on a PACKAGE booking, what one package hour is worth,
  // with every total zero because the package was paid for up front;
  // extraPersonCents is the per-extra-student surcharge as it stood then, so
  // the effective per-hour rate is re-derivable: base + (headcount-1) × extra.
  hourlyRateCents       Int
  extraPersonCents      Int    @default(0)
  subtotalCents         Int
  handoverDiscountCents Int
  totalCents            Int
  currency              String @default("CAD")

  // ── Payment plan ──
  /// FULL pays everything up front; DEPOSIT pays one hour now and the balance
  /// after the lesson; PACKAGE spends prepaid hours from `package`.
  paymentPlan      PaymentPlan @default(FULL)
  /// The lesson package paying for this booking, when paymentPlan is PACKAGE.
  packageId        String?
  /// What the deposit is for this booking (one hour at the booked rate).
  /// Equals totalCents when the plan is FULL.
  depositCents     Int         @default(0)
  /// Running total the coach has confirmed as received. The booking is settled
  /// when this reaches totalCents.
  amountPaidCents  Int         @default(0)
  balanceSettledAt DateTime?

  // ── What the student wants to work on ──
  /// Skill keys from lib/skills.ts the student asked to practise.
  requestedSkills String[] @default([])
  /// Student's self-reported level at booking time.
  studentLevel    String?

  // ── After the lesson ──
  /// The coach's written summary, visible to the student.
  coachSummary   String?   @db.Text
  coachSummaryAt DateTime?

  /// Exactly what was shown on the review page (price breakdown, cancellation
  /// policy, contact details). Frozen so editing the policy later cannot
  /// retroactively change the terms of an existing booking.
  disclosureSnapshot Json?

  confirmationSentAt DateTime?

  // Placeholders for coach-created bookings, before the student has signed in.
  inviteName    String?
  inviteEmail   String?
  /// Whether the coach flagged this student as under 18, so the signing link
  /// asks a guardian to sign.
  inviteIsMinor Boolean @default(false)

  participantNameSnapshot String?
  notes                   String? @db.Text

  status        BookingStatus @default(HOLD)
  holdExpiresAt DateTime? // null for coach-created bookings

  /// The waiver covering this booking. Not unique: one waiver covers every
  /// booking with that coach for the rest of the season.
  waiverId String?

  paymentMethod      PaymentMethod?
  paymentProofKey    String?
  paymentReference   String?
  paymentSubmittedAt DateTime?
  proofUploadedBy    UploadedBy?

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  /// Free-text note from the coach when they record the balance as settled,
  /// e.g. "cash on the hill". Not a payment record — see amountPaidCents.
  balanceNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      User?          @relation("BookingAccount", fields: [accountId], references: [id], onDelete: SetNull)
  participant  Participant?   @relation(fields: [participantId], references: [id], onDelete: SetNull)
  coach        User           @relation("BookingCoach", fields: [coachId], references: [id], onDelete: Restrict)
  resort       Resort         @relation(fields: [resortId], references: [id], onDelete: Restrict)
  coachDay     CoachDay       @relation(fields: [coachDayId], references: [id], onDelete: Restrict)
  reviewedBy   User?          @relation("BookingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cancelledBy  User?          @relation("BookingCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  waiver       Waiver?        @relation(fields: [waiverId], references: [id], onDelete: SetNull)
  waiverInvite WaiverInvite?
  videos       LessonVideo[]
  package      LessonPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([coachId, startAt])
  @@index([status, holdExpiresAt])
  @@index([accountId])
  @@index([coachDayId])
  @@index([waiverId])
  @@index([packageId])
}

/// One-time signing link for a coach-created booking. The plaintext token only
/// ever exists in the URL; the DB stores its SHA-256.
model WaiverInvite {
  id        String @id @default(cuid())
  bookingId String @unique
  tokenHash String @unique

  /// Who the link was issued to. The signer must sign in with this exact
  /// address — that binding is the identity evidence behind the signature.
  email String

  expiresAt   DateTime
  usedAt      DateTime?
  sentAt      DateTime?
  resentCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([email])
}

/// A video the coach recorded during a lesson, for the student to review.
///
/// Stored in the private storage directory like every other upload and served
/// only through an authenticated route — lesson footage of a child is not
/// something to leave on a guessable URL.
model LessonVideo {
  id        String @id @default(cuid())
  bookingId String

  /// Relative storage key, never a URL.
  storageKey  String
  contentType String
  bytes       Int
  caption     String?

  uploadedById String
  uploadedAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ───────────────────────── Lesson packages ─────────────────────────

enum PackageStatus {
  /// Ordered; waiting for the buyer to pay and upload proof.
  AWAITING_PAYMENT
  /// Proof uploaded, waiting on the coach who was paid.
  PENDING_PAYMENT_REVIEW
  /// The coach did not accept the proof; the buyer may re-upload.
  PAYMENT_REJECTED
  /// Paid. Hours can be spent on bookings.
  ACTIVE
  CANCELLED
}

/// Prepaid lesson hours ("课时包"), e.g. four hours at Blue Mountain for $180
/// with the coach the buyer paid. See lib/packages.ts.
///
/// Belongs to the account, so a parent can spend it on any of their
/// participants. Hours left are derived from the bookings pointing at it,
/// never stored, so an expired or cancelled booking hands its hours back.
///
/// A paid package is a payment record, so neither the buyer's account nor the
/// coach who was paid can be deleted out from under it.
model LessonPackage {
  id        String @id @default(cuid())
  code      String @unique // e.g. PKG-8F3K2M, quoted in the transfer memo
  accountId String

  // Snapshot of the offer at purchase time (lib/packages.ts PACKAGE_OFFERS).
  offerKey   String
  resortId   String
  lessonType String
  /// The season the hours can be used in, e.g. "2026-27".
  season     String
  hours      Int
  priceCents Int
  currency   String @default("CAD")

  /// The coach the buyer chose to pay. They confirm the payment, and the
  /// hours can only be booked with them.
  payeeCoachId String

  status             PackageStatus  @default(AWAITING_PAYMENT)
  paymentMethod      PaymentMethod?
  paymentProofKey    String?
  paymentReference   String?
  paymentSubmittedAt DateTime?

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account     User                @relation("PackageAccount", fields: [accountId], references: [id], onDelete: Restrict)
  payeeCoach  User                @relation("PackagePayee", fields: [payeeCoachId], references: [id], onDelete: Restrict)
  reviewedBy  User?               @relation("PackageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resort      Resort              @relation(fields: [resortId], references: [id], onDelete: Restrict)
  bookings    Booking[]
  adjustments PackageAdjustment[]

  @@index([accountId])
  @@index([payeeCoachId, status])
}

/// A coach changing how many hours a package holds — a make-up lesson, hours
/// given back, a correction. Append-only like the rest of the money record:
/// a mistake is fixed with another adjustment, never by editing this one.
model PackageAdjustment {
  id          String   @id @default(cuid())
  packageId   String
  /// Signed: +2 adds two hours, -1 takes one away.
  hours       Int
  /// Why, in the coach's words. Shown to the student.
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  package   LessonPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdBy User          @relation("PackageAdjuster", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([packageId])
}

// ──────────────────────────── Waivers ────────────────────────────

enum SignerRole {
  PARTICIPANT
  GUARDIAN
}

/// One per participant × coach × season × template major version.
/// Append-only: never updated, only superseded via revokedAt.
model Waiver {
  id            String @id @default(cuid())
  participantId String
  coachId       String

  /// "2025-26" — the season containing the lesson date (Dec 1 → May 1).
  season String

  /// Bumping the major version invalidates existing waivers and forces a
  /// re-sign; the revision is for typo fixes and does not.
  templateVersion  Int
  templateRevision Int
  templateHash     String

  signerUserId String
  signerRole   SignerRole
  signerName   String
  typedName    String

  /// PNG data URL from the signature canvas.
  signatureImage String @db.Text

  /// Whether the participant was under 18 at the lesson date when signed. Once
  /// they turn 18 the guardian-signed waiver stops applying.
  participantWasMinor Boolean

  guardianName         String?
  guardianEmail        String?
  guardianPhone        String?
  guardianRelationship String?

  /// Ontario's Electronic Commerce Act requires express consent to sign
  /// electronically — a separate box, not folded into "I have read this".
  consentToElectronic Boolean

  /// Which individual clauses were ticked, so we can show exactly what was
  /// agreed to rather than one blanket acknowledgement.
  agreedCheckboxes Json

  // Audit trail. All server-generated; client-supplied values are never used.
  signedAt  DateTime
  ipAddress String
  userAgent String   @db.Text

  signedPdfKey    String
  signedPdfSha256 String

  revokedAt    DateTime?
  revokeReason String?

  createdAt DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  coach       User        @relation("WaiverCoach", fields: [coachId], references: [id], onDelete: Restrict)
  signer      User        @relation("WaiverSigner", fields: [signerUserId], references: [id], onDelete: Restrict)
  bookings    Booking[]

  @@index([coachId, season])
  @@index([participantId])
}
